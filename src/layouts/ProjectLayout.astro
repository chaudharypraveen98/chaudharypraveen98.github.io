---
interface Props {
  title: string;
  description: string;
  date: Date;
  author?: string;
  tags?: string[];
  previewUrl?: string;
  repoUrl?: string;
  image?: string;
  headerImage?: string;
  slug: string;
}

const {
  title,
  description,
  date,
  author = 'Praveen Chaudhary',
  tags = [],
  previewUrl,
  repoUrl,
  image = 'https://media-exp1.licdn.com/dms/image/C5603AQHRamUaMrdA9g/profile-displayphoto-shrink_400_400/0/1597315489941?e=1629936000&v=beta&t=GjvQu_r0n3F2EtGkaRYSF6pH8vRdgx5lsD1-w8dc8gY',
  headerImage = '/projects/assets/img/post-bg.webp',
  slug,
} = Astro.props;

const siteUrl = 'https://www.praveenchaudhary.in';
const canonicalUrl = `${siteUrl}/projects/${slug}.html`;
const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);

const schemaOrgArticle = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: `${title} — Project | Praveen Chaudhary`,
  description,
  image: image.startsWith('http') ? image : `${siteUrl}${image}`,
  author: {
    '@type': 'Person',
    name: author,
    url: siteUrl,
  },
  datePublished: date.toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>{title} — Project | Praveen Chaudhary</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={`chaudharypraveen98,Praveen Chaudhary,devilunknown, Praveen Chaudhary projects, ${tags.join(', ')}`} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={author} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Project | Praveen Chaudhary`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — Project | Praveen Chaudhary`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="article" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgArticle)} />

    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Font Awesome -->
    <script src="https://use.fontawesome.com/releases/v5.15.3/js/all.js" crossorigin="anonymous"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Lora:400,700,400italic,700italic" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800" rel="stylesheet" type="text/css" />

    <!-- Core Theme CSS (includes Bootstrap) -->
    <link href="/projects/css/styles.css" rel="stylesheet" />

    <style is:global>
      /* Ensure images never overflow */
      article img {
        max-width: 100% !important;
        height: auto !important;
        display: block;
        margin: 2rem auto;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      }

      /* Style image captions */
      article em {
        display: block;
        text-align: center;
        color: #6c757d;
        font-size: 0.95rem;
        margin-top: -1rem;
        margin-bottom: 2rem;
      }

      /* Uncongested article typography */
      article {
        font-size: 1.15rem;
        line-height: 1.85;
        color: #2b2b2b;
        overflow-wrap: break-word;
        word-wrap: break-word;
      }

      article h2 {
        margin-top: 3rem;
        margin-bottom: 1.25rem;
        font-weight: 700;
        font-size: 1.85rem;
        color: #1a1a1a;
        border-bottom: 2px solid #f1f3f5;
        padding-bottom: 0.5rem;
      }

      article h3 {
        margin-top: 2.25rem;
        margin-bottom: 1rem;
        font-weight: 600;
        font-size: 1.45rem;
        color: #212529;
      }

      article p {
        margin-bottom: 1.5rem;
      }

      article ul, article ol {
        margin-bottom: 1.75rem;
        padding-left: 2rem;
      }

      article li {
        margin-bottom: 0.5rem;
      }

      article blockquote {
        border-left: 4px solid #0085A1;
        background: #f8fafc;
        padding: 1rem 1.5rem;
        margin: 2rem 0;
        border-radius: 0 8px 8px 0;
        color: #495057;
        font-style: italic;
      }

      /* Code Block Container with Copy Button */
      .code-block-wrapper {
        position: relative;
        margin: 2.25rem 0;
        border-radius: 10px;
        background: #24292e;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
      }

      .code-block-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #1b1f23;
        padding: 0.5rem 1rem;
        font-size: 0.78rem;
        color: #8b949e;
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        border-bottom: 1px solid #30363d;
      }

      .copy-code-btn {
        background: #21262d;
        border: 1px solid #363b42;
        color: #c9d1d9;
        border-radius: 6px;
        padding: 0.25rem 0.65rem;
        font-size: 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.2s ease;
      }

      .copy-code-btn:hover {
        background: #30363d;
        border-color: #8b949e;
        color: #ffffff;
      }

      .copy-code-btn.copied {
        background: #238636;
        border-color: #2ea043;
        color: #ffffff;
      }

      pre.astro-code {
        margin: 0 !important;
        padding: 1.25rem 1.5rem !important;
        font-size: 0.95rem !important;
        line-height: 1.65 !important;
        overflow-x: auto !important;
        border-radius: 0 0 10px 10px !important;
      }

      /* Project Meta Card */
      .project-meta-card {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 10px;
        padding: 1.25rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      .project-meta-card .badge-tag {
        font-size: 0.85rem;
        background-color: #e2e8f0;
        color: #334155;
        border: 1px solid #cbd5e1;
        border-radius: 20px;
        padding: 0.35rem 0.75rem;
        font-weight: 500;
        text-decoration: none;
      }

      .project-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 1rem;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none !important;
        transition: all 0.2s ease;
      }

      .project-action-btn.primary {
        background: #0085A1;
        color: #ffffff !important;
        border: 1px solid #0085A1;
      }

      .project-action-btn.primary:hover {
        background: #00657b;
      }

      .project-action-btn.secondary {
        background: #ffffff;
        color: #212529 !important;
        border: 1px solid #ced4da;
      }

      .project-action-btn.secondary:hover {
        background: #f8f9fa;
        border-color: #adb5bd;
      }
    </style>
  </head>

  <body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light" id="mainNav">
      <div class="container px-4 px-lg-5">
        <a class="navbar-brand" href="/projects/index.html">Praveen Chaudhary</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarResponsive"
          aria-controls="navbarResponsive"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          Menu
          <i class="fas fa-bars"></i>
        </button>
        <div class="collapse navbar-collapse" id="navbarResponsive">
          <ul class="navbar-nav ms-auto py-4 py-lg-0">
            <li class="nav-item"><a class="nav-link px-lg-3 py-3 py-lg-4" href="/index.html">Home</a></li>
            <li class="nav-item"><a class="nav-link px-lg-3 py-3 py-lg-4" href="https://www.praveenchaudhary.in/about.html">About</a></li>
            <li class="nav-item"><a class="nav-link px-lg-3 py-3 py-lg-4" href="https://www.praveenchaudhary.in/project-preview/">Latest Works</a></li>
            <li class="nav-item"><a class="nav-link px-lg-3 py-3 py-lg-4" href="https://www.praveenchaudhary.in/contact.html">Contact</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Page Header / Masthead -->
    <header class="masthead" style={`background-image: url('${headerImage}')`}>
      <div class="container position-relative px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
          <div class="col-md-10 col-lg-8 col-xl-7">
            <div class="post-heading">
              <h1>{title}</h1>
              <h2 class="subheading">{description}</h2>
              <span class="meta">
                Posted by <a href="https://github.com/chaudharypraveen98" class="text-white text-decoration-underline fw-bold">{author}</a> on {formattedDate}
              </span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Post Content -->
    <article class="mb-5">
      <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
          <div class="col-md-10 col-lg-8 col-xl-7">
            <!-- Modern Project Meta Bar -->
            {(tags.length > 0 || previewUrl || repoUrl) && (
              <div class="project-meta-card">
                {tags.length > 0 && (
                  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="text-muted small fw-bold me-1"><i class="fas fa-tags me-1"></i> Topics:</span>
                    {tags.map((tag) => (
                      <span class="badge-tag">#{tag}</span>
                    ))}
                  </div>
                )}
                {(previewUrl || repoUrl) && (
                  <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                    {previewUrl && (
                      <a href={previewUrl} target="_blank" rel="noopener" class="project-action-btn primary">
                        <i class="fas fa-external-link-alt"></i> Live Preview
                      </a>
                    )}
                    {repoUrl && (
                      <a href={repoUrl} target="_blank" rel="noopener" class="project-action-btn secondary">
                        <i class="fab fa-github"></i> Source Code
                      </a>
                    )}
                  </div>
                )}
              </div>
            )}

            <slot />
          </div>
        </div>
      </div>
    </article>

    <!-- Footer -->
    <footer class="border-top">
      <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
          <div class="col-md-10 col-lg-8 col-xl-7">
            <ul class="list-inline text-center">
              <li class="list-inline-item">
                <a href="https://twitter.com/chaudhpraveen98" aria-label="Twitter">
                  <span class="fa-stack fa-lg">
                    <i class="fas fa-circle fa-stack-2x"></i>
                    <i class="fab fa-twitter fa-stack-1x fa-inverse"></i>
                  </span>
                </a>
              </li>
              <li class="list-inline-item">
                <a href="https://www.linkedin.com/in/chaudharypraveen98/" aria-label="LinkedIn">
                  <span class="fa-stack fa-lg">
                    <i class="fas fa-circle fa-stack-2x"></i>
                    <i class="fab fa-linkedin fa-stack-1x fa-inverse"></i>
                  </span>
                </a>
              </li>
              <li class="list-inline-item">
                <a href="https://github.com/chaudharypraveen98" aria-label="GitHub">
                  <span class="fa-stack fa-lg">
                    <i class="fas fa-circle fa-stack-2x"></i>
                    <i class="fab fa-github fa-stack-1x fa-inverse"></i>
                  </span>
                </a>
              </li>
            </ul>
            <div class="small text-center text-muted fst-italic">Copyright &copy; Praveen Chaudhary {new Date().getFullYear()}</div>
          </div>
        </div>
      </div>
    </footer>

    <!-- Bootstrap core JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Navbar scroll handler
        let scrollPos = 0;
        const mainNav = document.getElementById('mainNav');
        if (mainNav) {
          const headerHeight = mainNav.clientHeight;
          window.addEventListener('scroll', () => {
            const currentTop = document.body.getBoundingClientRect().top * -1;
            if (currentTop < scrollPos) {
              if (currentTop > 0 && mainNav.classList.contains('is-fixed')) {
                mainNav.classList.add('is-visible');
              } else {
                mainNav.classList.remove('is-visible', 'is-fixed');
              }
            } else {
              mainNav.classList.remove('is-visible');
              if (currentTop > headerHeight && !mainNav.classList.contains('is-fixed')) {
                mainNav.classList.add('is-fixed');
              }
            }
            scrollPos = currentTop;
          });
        }

        // 2. Add Code Block Wrappers & Copy Buttons
        document.querySelectorAll('article pre').forEach((pre) => {
          const wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper';

          const header = document.createElement('div');
          header.className = 'code-block-header';

          const lang = pre.getAttribute('data-language') || 'code';
          const langSpan = document.createElement('span');
          langSpan.textContent = lang;
          header.appendChild(langSpan);

          const copyBtn = document.createElement('button');
          copyBtn.className = 'copy-code-btn';
          copyBtn.setAttribute('type', 'button');
          copyBtn.innerHTML = '<i class="far fa-copy"></i> <span>Copy</span>';

          copyBtn.addEventListener('click', async () => {
            const codeEl = pre.querySelector('code') || pre;
            try {
              await navigator.clipboard.writeText(codeEl.innerText);
              copyBtn.innerHTML = '<i class="fas fa-check"></i> <span>Copied!</span>';
              copyBtn.classList.add('copied');
              setTimeout(() => {
                copyBtn.innerHTML = '<i class="far fa-copy"></i> <span>Copy</span>';
                copyBtn.classList.remove('copied');
              }, 2000);
            } catch (err) {
              console.error('Failed to copy: ', err);
            }
          });

          header.appendChild(copyBtn);

          pre.parentNode.insertBefore(wrapper, pre);
          wrapper.appendChild(header);
          wrapper.appendChild(pre);
        });

        // 3. Fallback for broken external images
        document.querySelectorAll('article img').forEach((img) => {
          img.addEventListener('error', () => {
            img.style.display = 'none';
            const notice = document.createElement('div');
            notice.className = 'alert alert-light border text-muted small text-center my-3';
            notice.innerHTML = '<i class="fas fa-image me-1"></i> Preview screenshot unavailable';
            img.parentNode.insertBefore(notice, img.nextSibling);
          });
        });
      });
    </script>
  </body>
</html>
